<Window x:Class="Efr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="estetele-format-reset" Width="1220" Height="820" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#0D0A12" Foreground="#F2EEF9" Icon="efr.ico">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#100B18">
      <DockPanel Margin="22,28,18,22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
          <Image Source="{StaticResource EfrLogo}" Width="112" Height="54" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="Efr"/>
          <TextBlock Text="estetele-format-reset" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/>
          <TextBlock Text="Seu Windows, preparado por você." Foreground="#A89BBE" Margin="0,8,0,0" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#21162F" CornerRadius="8" Padding="12"><TextBlock Text="Portátil significa sem instalador. Os ajustes feitos no Windows permanecem após fechar o aplicativo." Foreground="#C9BDDA" FontSize="12"/></Border>
          <TextBlock Text="v0.1.0 · Windows 11 x64" Foreground="#A89BBE" Margin="0,18,0,0" FontSize="11"/>
        </StackPanel>
        <ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="CategoryChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,13"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#412365"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#2F1D46"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" Background="#2B1945" CornerRadius="5" Padding="10,5" VerticalAlignment="Top"><TextBlock x:Name="ModeLabel" Text="PERSONALIZE COM CONTROLE" Foreground="#C9A6FF" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="Depois da formatação" FontSize="27" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Escolha o que faz sentido para o seu uso. Revise antes de aplicar." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
        <TextBlock x:Name="MachineLabel" Foreground="{StaticResource Muted}" FontSize="11"/>
        <Border x:Name="WarningBox" Background="#34231B" CornerRadius="7" Padding="10" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="WarningLabel" Foreground="#EFC59A"/></Border>
      </StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,20,0,18" x:Name="Toolbar">
        <Button Content="Perfil do XML" Click="XmlProfileClick" ToolTip="Seleciona ajustes viáveis do XML, Notepad++ e Desempenho Máximo."/>
        <Button Content="Perfil conservador" Click="ConservativeClick" ToolTip="Seleciona apenas extensões visíveis e Este Computador."/>
        <Button Content="Limpar seleção" Click="ClearClick"/>
        <Button Content="Consultar novamente" Click="RefreshClick"/>
        <Button x:Name="AdminButton" Content="Reabrir como administrador" Click="AdminClick"/>
      </WrapPanel>
      <DockPanel Grid.Row="2" Margin="0,0,0,12">
        <TextBlock x:Name="CategoryTitle" Text="Explorador e interface" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="3">
        <ScrollViewer x:Name="AdjustmentsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="AdjustmentsList">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#17121F" BorderBrush="#34283F" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,10,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="{Binding Item.Name}"/>
                  <StackPanel Grid.Column="1">
                    <DockPanel><TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" Foreground="#C5A3FF" FontSize="11" FontWeight="SemiBold" Margin="10,3,0,0"/><TextBlock Text="{Binding Item.Name}" FontSize="15" FontWeight="SemiBold"/></DockPanel>
                    <TextBlock Text="{Binding Item.Description}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding Item.Details}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Detail}" Foreground="#A497B6" FontSize="11" Margin="0,6,0,0"/>
                    <Button Content="Abrir orientação / Configurações" Click="GuideClick" Tag="{Binding}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" Visibility="{Binding HasGuide, Converter={StaticResource BoolVisibility}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer x:Name="HistoryScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <WrapPanel Margin="0,0,0,14"><Button Content="Criar ponto de restauração" Click="RestorePointClick"/><Button Content="Abrir pasta do histórico" Click="OpenHistoryClick"/></WrapPanel>
            <TextBlock Text="O backup de valores do EFR é separado da Restauração do Sistema. Remoções e instalações exigem recuperação manual. Ponto de restauração pode falhar se a proteção estiver desabilitada ou pelo limite de frequência." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="Backups disponíveis" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <ItemsControl x:Name="BackupsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#17121F" CornerRadius="7" Padding="12" Margin="0,0,8,8"><DockPanel><Button Content="Restaurar original" Tag="{Binding}" DockPanel.Dock="Right" Click="UndoClick"/><StackPanel><TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Item.Restart}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Registro de operações" FontWeight="SemiBold" FontSize="16" Margin="0,16,0,10"/>
            <TextBox x:Name="HistoryText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,12,0,0">
        <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Foreground="#A879FF" Background="#30223D"/>
        <TextBlock x:Name="StatusLabel" Text="Pronto para consultar o Windows." Foreground="{StaticResource Muted}" Margin="0,8,0,12" FontSize="12"/>
        <DockPanel>
          <Button x:Name="ApplyButton" Content="Iniciar configurações principais" IsEnabled="False" Background="#8445DF" BorderBrush="#A879FF" Foreground="White" Click="ApplyClick" DockPanel.Dock="Right" Margin="0" Padding="16,11"/>
          <Button x:Name="ValidateButton" Content="Validar configuração" Click="ValidateClick" DockPanel.Dock="Right" Padding="14,11"/>
          <Button x:Name="StopButton" Content="Parar após a operação atual" Click="StopClick" DockPanel.Dock="Right" Visibility="Collapsed"/>
          <TextBlock x:Name="SelectionLabel" Text="Nenhum ajuste selecionado" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
