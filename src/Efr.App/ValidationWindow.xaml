<Window x:Class="Efr.App.ValidationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Validação da configuração · Efr" Width="1120" Height="810" MinWidth="960" MinHeight="650" Background="#0D0A12" Foreground="#F2EEF9" WindowStartupLocation="CenterOwner" Icon="efr.ico">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <Image Source="{StaticResource EfrLogo}" Width="85" Height="42" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
   <StackPanel><TextBlock x:Name="Heading" Text="Validação da configuração" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="Cada item será verificado antes de liberar as alterações." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#20152D" BorderBrush="#51346E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,22,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="VERIFICAÇÃO EM ANDAMENTO" x:Name="Phase" Foreground="#C39CFF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="CurrentTest" Text="Preparando testes…" FontSize="18" FontWeight="SemiBold" Margin="0,6,12,6"/><TextBlock x:Name="CurrentDetail" Foreground="{StaticResource Muted}" Margin="0,0,12,10"/><ProgressBar x:Name="TotalProgress" Height="7" Minimum="0" Maximum="100" Foreground="#A879FF" Background="#372449"/><TextBlock x:Name="Counter" Text="0 testes concluídos" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="Percentage" Text="0%" FontSize="36" FontWeight="SemiBold" Foreground="#C9ABFF"/><ProgressBar x:Name="Activity" IsIndeterminate="True" Height="3" Width="80" Foreground="#A879FF" Background="#372449" Margin="0,8,0,8"/><TextBlock x:Name="Elapsed" Text="00:00" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PassedCount" Text="0 aprovados" Foreground="#99DEBE" FontSize="14"/>
   <TextBlock Grid.Column="1" x:Name="WarningCount" Text="0 ressalvas" Foreground="#E8C58B" FontSize="14"/>
   <TextBlock Grid.Column="2" x:Name="FailedCount" Text="0 bloqueados" Foreground="#FF9FAE" FontSize="14"/>
   <TextBlock Grid.Column="3" x:Name="PendingCount" Text="0 próximos" Foreground="#B9A4DC" FontSize="14" HorizontalAlignment="Right"/>
  </Grid>
  <ListBox Grid.Row="3" x:Name="TestsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><Border Background="#17121F" BorderBrush="#352842" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" Foreground="#89759F" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,12,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="4" Margin="0,18,0,0"><TextBlock x:Name="Conclusion" Text="Não feche durante um teste. Cancelar interrompe os próximos; nenhum ajuste do Windows é aplicado nesta fase." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><DockPanel><Button x:Name="FinishButton" Content="Voltar à configuração" IsEnabled="False" Click="FinishClick" DockPanel.Dock="Right" Margin="0" Background="#8445DF" BorderBrush="#A879FF"/><Button x:Name="CancelButton" Content="Cancelar testes restantes" Click="CancelClick" DockPanel.Dock="Right"/><TextBlock Text="O teste verifica as condições atuais. O efeito final será conferido depois da aplicação." Foreground="#AA9ABF" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel></StackPanel>
 </Grid>
</Window>
